// Aalmaram Health - canonical data model (class diagram v1, docs/platform/class-diagram.md)
//
// Design notes:
//  * Component.moduleId is deliberately NOT stored. Module is derived through
//    Catalogue so there is a single source of truth for the hierarchy.
//  * Client 1->* Trip, Trip 1->1 Itinerary. The itinerary is built in place and
//    locked by `confirmedAt`; trip progress lives on Trip.status.
//  * An ItineraryItem is a "block": one component, optionally at one branch,
//    at a start time. Booking state will sit beside it (Booking), not on it.
//  * Block times are Kerala wall-clock times stored as UTC timestamps
//    ("floating" times): 09:30 is stored as 09:30Z and always formatted in UTC,
//    so server and browser time zones can never shift a block.

generator client {
  provider      = "prisma-client-js"
  // "native" for local development; the RHEL target is what Vercel's Linux
  // runtime needs, and generating both keeps one lockfile working in both places.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StaffRole {
  ADMIN
  RELATIONSHIP_MANAGER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ClientStatus {
  LEAD
  INTAKE
  PLANNING
  PROPOSAL_SENT
  CONFIRMED
  ARCHIVED
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

enum ChangeRequestStatus {
  OPEN
  RESOLVED
}

enum CostStatus {
  ESTIMATED
  CONFIRMED
  ON_REQUEST
}

enum TripStatus {
  PLANNING
  AWAITING_PAYMENT
  BOOKING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Pace {
  RELAXED
  BALANCED
  PACKED
}

enum Channel {
  AI_CHAT
  STAFF_CHAT
  CALL
  EMAIL
  WHATSAPP
  IN_PERSON
}

// TEAM = the health core placed by staff; the client cannot move or remove it.
enum AddedBy {
  TEAM
  CLIENT
  AI
}

enum FeedSource {
  VENDOR_INSTAGRAM
  KERALA_TOURISM
  NEWS
}

// FOR_TWO = restaurants, priced from Google's "average for two".
enum PriceUnit {
  PER_PERSON
  FOR_TWO
  PER_GROUP
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  roles        StaffRole[]  @default([ADMIN])
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  activityLogs   ActivityLog[]
  managedClients Client[]       @relation("RelationshipManager")
  conversations  Conversation[]
}

// ---------------------------------------------------------------------------
// Inventory: Vendor -> Component, Module -> Catalogue -> Component
// ---------------------------------------------------------------------------

// contactName, email, phone and notes are INTERNAL: we coordinate every booking,
// so the client never needs them. Everything else is client-visible profile.
model Vendor {
  id              String       @id @default(cuid())
  name            String       @unique
  description     String?
  contactName     String?
  email           String?
  phone           String?
  hqLine          String?
  hqCity          String?
  hqPostcode      String?
  hqCountry       String?
  website         String?
  socialLinks     String[]     @default([])
  accreditations  String[]     @default([])
  languages       String[]     @default([])
  yearEstablished Int?
  staffCount      Int?
  equipment       String[]     @default([])
  owners          String[]     @default([])
  status          RecordStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  components    Component[]
  branches      Branch[]
  practitioners Practitioner[]
  feedPosts     FeedPost[]

  @@index([status])
}

/// A vendor's location; the client picks one per block (a lab chain may have ~100).
model Branch {
  id          String       @id @default(cuid())
  vendorId    String
  name        String
  addressLine String?
  city        String
  postcode    String?
  country     String       @default("India")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  vendor Vendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  blocks ItineraryItem[]

  @@unique([vendorId, name])
}

/// Doctor, therapist, instructor, guide or performer engaged by one vendor.
model Practitioner {
  id                String       @id @default(cuid())
  vendorId          String
  name              String
  role              String
  qualifications    String[]     @default([])
  achievements      String[]     @default([])
  yearsOfExperience Int?
  languages         String[]     @default([])
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  vendor     Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  components ComponentPractitioner[]

  @@index([vendorId])
}

/// "Delivered by". Optional: health always, wellness and culture some, restaurants never.
/// The link is not inventory itself, so it cascades with either side.
model ComponentPractitioner {
  componentId    String
  practitionerId String

  component    Component    @relation(fields: [componentId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@id([componentId, practitionerId])
  @@index([practitionerId])
}

model Module {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  sortOrder   Int          @default(0)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  catalogues Catalogue[]
  tripShares TripModuleShare[]

  @@index([sortOrder])
}

model Catalogue {
  id          String       @id @default(cuid())
  moduleId    String
  name        String
  description String?
  sortOrder   Int          @default(0)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  module     Module      @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  components Component[]

  @@unique([moduleId, name])
  @@index([moduleId])
  @@index([status])
}

model Component {
  id                      String       @id @default(cuid())
  vendorId                String
  catalogueId             String
  name                    String
  tags                    String[]     @default([])
  price                   Decimal      @db.Decimal(10, 2)
  currency                String       @default("EUR")
  priceUnit               PriceUnit    @default(PER_PERSON)
  durationMinutes         Int
  recoveryTimeMinutes     Int?
  costStatus              CostStatus   @default(ESTIMATED)
  clientFacingDescription String
  whatsIncluded           String?
  clientDeliverable       String?
  source                  String?
  sourceDate              DateTime?
  status                  RecordStatus @default(ACTIVE)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  vendor         Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  catalogue      Catalogue               @relation(fields: [catalogueId], references: [id], onDelete: Restrict)
  itineraryItems ItineraryItem[]
  practitioners  ComponentPractitioner[]

  @@unique([vendorId, name])
  @@index([catalogueId])
  @@index([vendorId])
  @@index([status])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

model Client {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  phone       String?
  dateOfBirth DateTime?    @db.Date
  addressLine String?
  city        String?
  postcode    String?
  country     String?
  status      ClientStatus @default(LEAD)

  // Lasting notes across trips until ClientPreference arrives (Phase 8).
  generalPreferences String?
  termsAcceptedAt    DateTime?

  relationshipManagerId String?

  // Secure, non-guessable portal access. Only the SHA-256 hash of the
  // invitation token is stored; the raw token lives only in the invite link.
  accessTokenHash      String?   @unique
  accessTokenIssuedAt  DateTime?
  accessTokenExpiresAt DateTime?
  lastPortalLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relationshipManager User?          @relation("RelationshipManager", fields: [relationshipManagerId], references: [id], onDelete: SetNull)
  trips               Trip[]
  conversations       Conversation[]

  @@index([status])
  @@index([name])
  @@index([relationshipManagerId])
}

// ---------------------------------------------------------------------------
// Trips: requirements, conversations, one itinerary each
// ---------------------------------------------------------------------------

model Trip {
  id         String     @id @default(cuid())
  clientId   String
  name       String
  startDate  DateTime   @db.Date
  endDate    DateTime   @db.Date
  travellers Int        @default(1)
  status     TripStatus @default(PLANNING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  itinerary     Itinerary?
  requirements  TripRequirements?
  conversations Conversation[]

  @@index([clientId])
  @@index([status])
}

/// What the client wants for THIS trip (lasting preferences live on the client).
model TripRequirements {
  id             String   @id @default(cuid())
  tripId         String   @unique
  summary        String
  budgetAmount   Decimal? @db.Decimal(10, 2)
  budgetCurrency String?
  pace           Pace?
  mustHaves      String[] @default([])
  avoid          String[] @default([])
  updatedAt      DateTime @updatedAt

  trip      Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  moduleMix TripModuleShare[]
}

/// One module's share of the trip; a mix sums to 100 (validated in the domain).
model TripModuleShare {
  requirementsId String
  moduleId       String
  percent        Int

  requirements TripRequirements @relation(fields: [requirementsId], references: [id], onDelete: Cascade)
  module       Module           @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@id([requirementsId, moduleId])
  @@index([moduleId])
}

/// Transcripts and summaries are SENSITIVE: never logged, never in AiRun.output,
/// staff-only except the client's own chat.
model Conversation {
  id          String   @id @default(cuid())
  clientId    String
  tripId      String?
  channel     Channel
  occurredAt  DateTime
  transcript  String
  summary     String?
  createdById String?
  createdAt   DateTime @default(now())

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trip      Trip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([tripId])
}

// ---------------------------------------------------------------------------
// Itineraries
// ---------------------------------------------------------------------------

/// Exactly one per trip, created with it. `confirmedAt` locks it: blocks and
/// prices freeze and later changes go through the relationship manager.
/// The total is derived from the blocks, never stored.
model Itinerary {
  id          String    @id @default(cuid())
  tripId      String    @unique
  confirmedAt DateTime?
  adminNotes  String?
  clientNotes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items          ItineraryItem[]
  report         Report?
  changeRequests ChangeRequest[]
}

/// A block. endsAt is derived (startsAt + component duration). `price` is the
/// component price times its unit for the trip's travellers: recomputed while
/// planning, frozen at confirm.
model ItineraryItem {
  id                String   @id @default(cuid())
  itineraryId       String
  componentId       String
  branchId          String?
  startsAt          DateTime
  addedBy           AddedBy
  price             Decimal  @db.Decimal(10, 2)
  currency          String
  customTitle       String?
  clientFacingNotes String?
  internalNotes     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  itinerary      Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  component      Component       @relation(fields: [componentId], references: [id], onDelete: Restrict)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  changeRequests ChangeRequest[]

  @@index([itineraryId, startsAt])
  @@index([componentId])
  @@index([branchId])
}

model Report {
  id          String       @id @default(cuid())
  itineraryId String       @unique
  title       String
  content     String
  status      ReportStatus @default(DRAFT)
  generatedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}

/// Legacy (proposal flow, retired 2026-10-22): no longer written. Dropped once a
/// human confirms production holds nothing worth keeping.
model ChangeRequest {
  id              String              @id @default(cuid())
  itineraryId     String
  itineraryItemId String?
  message         String
  status          ChangeRequestStatus @default(OPEN)
  createdAt       DateTime            @default(now())
  resolvedAt      DateTime?

  itinerary     Itinerary      @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  itineraryItem ItineraryItem? @relation(fields: [itineraryItemId], references: [id], onDelete: SetNull)

  @@index([itineraryId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Feed: what Kerala looks like right now (vendor socials, tourism, good news)
// ---------------------------------------------------------------------------

/// Staff curate the feed; `hiddenAt` takes a post off it (only "positive" news
/// is shown). `externalId` de-duplicates re-imports of the same post.
model FeedPost {
  id          String     @id @default(cuid())
  source      FeedSource
  vendorId    String?
  caption     String
  mediaUrl    String?
  link        String
  publishedAt DateTime
  externalId  String?    @unique
  hiddenAt    DateTime?
  createdAt   DateTime   @default(now())

  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([hiddenAt, publishedAt])
  @@index([vendorId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model ActivityLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorLabel  String
  entityType  String
  entityId    String
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
