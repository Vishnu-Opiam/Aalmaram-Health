# ---------------------------------------------------------------------------
# Aalmaram Health - environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local development (embedded postgres started by `npm run db:start`):
DATABASE_URL="postgresql://aalmaram:aalmaram@localhost:5433/aalmaram?schema=public"

# Secret used to sign admin + client session cookies (HS256).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-at-least-32-random-characters-0000"

# Public origin of the app. Used for links in emails and the client sign-in address.
APP_URL="http://localhost:3000"

# Email transport: "log" (development, writes to stdout + .mail.log) or "smtp".
EMAIL_TRANSPORT="log"
EMAIL_FROM="Aalmaram Health <no-reply@aalmaram.example>"

# Address the homepage's "Book a free call" button writes to. Unset: the button
# leads to a "call booking opens soon" note instead.
# CONTACT_EMAIL=""

# Only required when EMAIL_TRANSPORT="smtp"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# Demo/seed admin account (development only - never set in production).
SEED_ADMIN_EMAIL="admin@aalmaram.test"
SEED_ADMIN_PASSWORD="Aalmaram!Demo1"

# Local embedded postgres port (used by scripts/pg.mjs only)
EMBEDDED_PG_PORT="5433"

# AI (Vercel AI Gateway via the AI SDK). "fake" is deterministic and offline:
# development, tests and CI always use it. Set AI_PROVIDER="gateway" plus a key
# (or Vercel OIDC on deployments) to call real models.
AI_PROVIDER="fake"
# AI_GATEWAY_API_KEY=""
# AI_MODEL_REASONING="anthropic/claude-sonnet-5.5"
# AI_MODEL_FAST="anthropic/claude-haiku-5.5"   # also picks which Instagram posts reach the Feed

# Vendor Instagram → client Feed (Instagram Graph API, business discovery).
# Needs our own Instagram business account linked to a Meta app; vendors must
# be business or creator accounts. Unset: development fetches demo posts.
# INSTAGRAM_ACCESS_TOKEN=""
# INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# Vercel Cron's bearer token for /api/cron/feed (16+ characters). Unset: the
# daily feed run refuses every request; staff can still fetch from /admin/feed.
# CRON_SECRET=""
