# ---------------------------------------------------------------------------
# Aalmaram Health - environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local development (embedded postgres started by `npm run db:start`):
DATABASE_URL="postgresql://aalmaram:aalmaram@localhost:5433/aalmaram?schema=public"

# Secret used to sign admin + client session cookies (HS256).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-at-least-32-random-characters-0000"

# Public origin of the app. Used to build client invitation links in emails.
APP_URL="http://localhost:3000"

# Email transport: "log" (development, writes to stdout + .mail.log) or "smtp".
EMAIL_TRANSPORT="log"
EMAIL_FROM="Aalmaram Health <no-reply@aalmaram.example>"

# Only required when EMAIL_TRANSPORT="smtp"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# Demo/seed admin account (development only - never set in production).
SEED_ADMIN_EMAIL="admin@aalmaram.test"
SEED_ADMIN_PASSWORD="Aalmaram!Demo1"

# Local embedded postgres port (used by scripts/pg.mjs only)
EMBEDDED_PG_PORT="5433"
